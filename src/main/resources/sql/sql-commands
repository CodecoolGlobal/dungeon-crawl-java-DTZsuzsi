CREATE TABLE inventory (
id SERIAL PRIMARY KEY,
game_state_id INT,
item_name VARCHAR(50),
FOREIGN KEY (game_state_id) REFERENCES game_state(id) ON DELETE CASCADE
);

CREATE TABLE player_state (
id SERIAL PRIMARY KEY,
game_state_id INT,
form VARCHAR(50),
health INT,
attack INT,
FOREIGN KEY (game_state_id) REFERENCES game_state(id) ON DELETE CASCADE
);
